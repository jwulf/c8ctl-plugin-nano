{
  "name": "c8ctl-plugin-nano",
  "version": "0.1.0",
  "type": "module",
  "description": "c8ctl plugin to start, inspect, and stop a local Nano BPM (nanobpmn) cluster",
  "main": "c8ctl-plugin.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwulf/c8ctl-plugin-nano"
  },
  "keywords": [
    "c8ctl",
    "c8ctl-plugin",
    "nano",
    "nanobpmn",
    "nano-bpm",
    "camunda"
  ],
  "files": [
    "c8ctl-plugin.js",
    "platforms.mjs",
    "agentic.mjs",
    "agentic-loader-hook.mjs",
    "agentic-endpoint.mjs",
    "supervisor-engine.mjs",
    "work-channel.mjs",
    "work-relay.mjs",
    "work-buffer.mjs",
    "supervisor.dist.js",
    "nanobpmn-binary.json",
    "README.md"
  ],
  "scripts": {
    "lint": "node --check c8ctl-plugin.js",
    "typecheck:supervisor": "tsc -p supervisor/tsconfig.json",
    "build:supervisor": "node supervisor/build.mjs",
    "vendor:effect": "node scripts/vendor-effect.mjs",
    "test:supervisor": "node --experimental-strip-types --test supervisor/test/*.test.ts",
    "test": "node --check c8ctl-plugin.js && npm run typecheck:supervisor && npm run build:supervisor && npm run test:supervisor && node --test",
    "prepublishOnly": "npm run typecheck:supervisor && npm run build:supervisor"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "c8ctl": {
    "defaults": {
      "basePort": 8080,
      "nanobpmnRepo": "~/workspace/nanobpmn"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.6",
    "@types/node": "^22.20.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "^0.24.2",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nanobpm/agentic": "^0.12.0",
    "@nanobpm/urban-agent-client": "^0.1.12"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
